<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime entitlements -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Allow running sub-processes (Python backend, git, uv, ffmpeg) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Network client (GitHub API, YouTube via yt-dlp, localhost backend) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- File access -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Audio output -->
	<key>com.apple.security.device.audio-input</key>
	<false/>
	<!-- Allow JIT for Python (needed by some PyTorch operations) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Disable library validation to allow loading Python extensions -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
